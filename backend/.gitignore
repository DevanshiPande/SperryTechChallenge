# ---- Secrets: never commit (copy .env.example to .env locally; set real values in Render)
.env
.env.*
!.env.example
*.pem
*.key
atlas-credentials*

# ---- Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Local tools (poppler pdftotext for the offline pipeline, browsers for UI tests)
.tools/
.playwright/

# ---- Regenerated by the pipeline (pdftotext output of the PDFs in data/raw)
data/text/

# ---- Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs
*.log

# Committed on purpose (the server needs them at runtime; the API never parses PDFs or calls Overpass/FCC):
#   data/projects.json, data/overlaps.json   public filing data + overlaps (built by `python -m pipeline.build`)
#   data/traffic/                           OSM roads + SCDOT/GDOT traffic counts (`python -m pipeline.fetch_traffic`)
#   data/osm_cache/, data/overrides.csv     substation matcher inputs (used by contract matching)
#   data/county_cache.json, data/review/    pipeline caches and review sheets
#   data/raw/, data/samples/                source PDFs, Sperry's answer key, fictional sample contract (tests use them)
#   config/cost_sources.json                every sourced cost/traffic constant
